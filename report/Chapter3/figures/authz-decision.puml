@startuml authz-decision
'==============================================================================
' Figure (Chapter II, Security): the authorization decision comby applies to
' every command and query, before the domain handler runs. The guards form an
' ordered cascade; the first that resolves wins. CLMPilot operates at tenant
' scope -- the finer workspace-scoped grant is a framework capability it does
' not yet exercise (see the multi-tenancy seam, Section "Designed seams").
' Render:  plantuml -tpdf authz-decision.puml   (or -tpng)
'==============================================================================
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 20
skinparam activity {
  BackgroundColor #F4F4F8
  BorderColor #6B6B8A
  DiamondBackgroundColor #FDFDFF
}

start
:Command or query dispatched,\nwith its request context;
if (Internal / system\noperation?) then (yes)
  :Allow;<<#C9E7C9>>
elseif (A custom rule\ngrants it?) then (yes)
  :Allow;<<#C9E7C9>>
elseif (Platform system\nadministrator?) then (yes)
  :Allow\n(cross-tenant);<<#C9E7C9>>
elseif (Target tenant differs\nfrom caller's?) then (yes)
  :Deny\n(cross-tenant);<<#F2C7C7>>
elseif (Caller's tenant group\ngrants it?) then (yes)
  :Allow;<<#C9E7C9>>
elseif (Workspace-scoped grant?\n[framework]) then (yes)
  :Allow\n(workspace);<<#C9E7C9>>
else (none of these)
  :Deny;<<#F2C7C7>>
endif
stop
@enduml
