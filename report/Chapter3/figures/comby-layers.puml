@startuml comby-layers
'==============================================================================
' Figure (Chapter II): Layering of CLMPilot on the comby framework.
' Render:  plantuml -tpdf comby-layers.puml      (or -tpng)
'==============================================================================
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam componentStyle rectangle
skinparam ranksep 30
skinparam nodesep 25

package "Browser" {
  component "Vue 3 single-page application" as spa
}

package "CLMPilot backend service (Go)" {
  package "CLMPilot domains (custom)" as custom {
    package "Core contexts" as corectx {
      component "Contract" as c1
      component "Approval" as c2
      component "Deadline" as c3
      component "DocumentLink" as c4
    }
    package "Enterprise contexts" as entctx {
      component "Signature" as e1
      component "Obligation" as e2
      component "CustomField" as e3
      component "Reporting\n(read-side projections)" as e4
    }
    component "Cross-cutting:\narchived-tenant middleware,\nsystem-admin seed reactor" as xcut
  }
  package "comby framework (defaults + core)" as comby {
    component "Command bus  /  Query bus" as buses
    component "Event store  /  projection runner  /  reactors" as core
    component "Defaults: tenant, account, identity,\ngroup, invitation, asset, webhook" as defaults
    component "Auto-generated REST API (OpenAPI)" as api
  }
}

database "PostgreSQL\n(event / command / data store)" as pg
database "Redis\n(sessions, cache)" as redis
queue    "NATS\n(event distribution)" as nats
database "MinIO\n(assets, exports)" as minio

spa    --> api    : HTTPS (generated client)
custom --> comby  : registers domains on
comby  --> pg
comby  --> redis
comby  --> nats
comby  --> minio
@enduml
