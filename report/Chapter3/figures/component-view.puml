@startuml component-view
'==============================================================================
' Figure (Chapter III): CLMPilot component view -- one provided interface and
' three required interfaces, each named so the implementation is swappable.
' Conceptual on purpose (supervisor feedback): roles, not products -- the
' concrete tools behind each component are named in Chapter IV.
' Render:  plantuml -tpdf component-view.puml      (or -tpng)
'==============================================================================
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam componentStyle rectangle
skinparam ranksep 26
skinparam nodesep 22

component "Frontend\n(SPA)" as fe
component "Backend" as be

' Provided interface: the generated REST/OpenAPI contract.
interface "REST / OpenAPI" as rest
be -up- rest
fe -up-( rest : consumes\n(generated client)

' Required interfaces: named seams behind which providers are swappable.
interface "IntelligenceClient" as iIntel
interface "Email" as iMail
interface "DocumentStore" as iStore

be -down-( iIntel
be -down-( iMail
be -down-( iStore

component "Intelligence\nservice" as intel
component "Email\nprovider" as mail
component "Cloud storage\nadapters" as store

iIntel -down- intel
iMail  -down- mail
iStore -down- store
@enduml
