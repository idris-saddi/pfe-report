@startuml uc-approvals-deadlines
'==============================================================================
' Detailed use cases: Approvals (Sec. 4.4) and Deadlines & obligations (Sec. 4.3).
' Render:  plantuml -tsvg uc-approvals-deadlines.puml && \
'          rsvg-convert -f pdf -o uc-approvals-deadlines.pdf uc-approvals-deadlines.svg
'==============================================================================
left to right direction
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam ranksep 60
skinparam nodesep 12
skinparam usecase {
  BorderColor      #34495E
  BackgroundColor  #FDFEFE
  ArrowColor       #5D6D7E
}

actor "Legal Manager" as lm
actor "Approver"      as appr
actor "System clock"  as clock
actor "User"          as user
lm   --|> user
appr --|> user

rectangle "Approvals & deadlines" {
  usecase "Send deadline\nreminder"    as UC_remind
  usecase "Initiate approval\nworkflow" as UC_initappr
  usecase "Select workflow\ntemplate"  as UC_template
  usecase "Decide on approval step\n(approve / reject /\nrequest changes)" as UC_decide
  usecase "Return contract\nto initiator" as UC_return
  usecase "Consult approval\nhistory"  as UC_apprhist
  usecase "Acknowledge\ndeadline reminder" as UC_ack
  usecase "Track post-signature\nobligations" as UC_oblig
}

lm    --> UC_initappr
lm    --> UC_remind
lm    --> UC_apprhist
lm    --> UC_ack
lm    --> UC_oblig
appr  --> UC_decide
appr  --> UC_apprhist
clock --> UC_remind
UC_initappr ..> UC_template : <<include>>
UC_return   ..> UC_decide   : <<extend>>

note bottom of UC_remind
  Fires 90 / 60 / 30 days before
  the notice window, and on close
end note
@enduml
