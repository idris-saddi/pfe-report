@startuml usecase-overview
'==============================================================================
' Figure (Chapter I): High-level use-case diagram for CLMPilot.
' Each middle use case names a functional area (Sec. 4.1-4.8); the detailed,
' per-area use cases are catalogued in the functional-requirements section and
' the actor table (tab:actors). Human actors sit on the left, the System clock
' on the right, the system boundary in the middle.
' Render:  plantuml -tsvg usecase-overview.puml && \
'          rsvg-convert -f pdf -o usecase-overview.pdf usecase-overview.svg
'==============================================================================
left to right direction
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam ranksep 90
skinparam nodesep 16
skinparam usecase {
  BorderColor      #34495E
  BackgroundColor  #FDFEFE
  ArrowColor       #5D6D7E
}

' ---------------- Actors: human roles on the left ----------------
actor "User"          as user
actor "Admin"         as admin
actor "Legal Manager" as lm
actor "Approver"      as appr
actor "Auditor"       as aud

' The four roles specialise a common User, inheriting authentication.
admin --|> user
lm    --|> user
appr  --|> user
aud   --|> user

' ---------------- System boundary: one use case per functional area ----------------
rectangle "CLMPilot" {
  usecase "Authenticate\n(password + email OTP)"      as UC_auth
  usecase "Administer users,\nroles & policies"       as UC_iam
  usecase "Manage contracts\n& documents"             as UC_contracts
  usecase "Run approval\nworkflows"                    as UC_approvals
  usecase "Track deadlines\n& obligations"            as UC_deadlines
  usecase "View dashboards\n& reports"                as UC_reporting
  usecase "Audit & reconstruct\nhistory"              as UC_audit
}

' ---------------- Associations ----------------
user  --> UC_auth
admin --> UC_iam
admin --> UC_audit
lm    --> UC_contracts
lm    --> UC_approvals
lm    --> UC_deadlines
lm    --> UC_reporting
appr  --> UC_approvals
aud   --> UC_audit

' ---------------- System clock (secondary actor that drives reminders) ----------------
actor "System clock" as clock
clock --> UC_deadlines

@enduml
