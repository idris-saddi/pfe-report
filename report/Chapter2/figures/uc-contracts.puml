@startuml uc-contracts
'==============================================================================
' Detailed use cases: Contracts & documents (Sec. 4.1-4.2, enterprise 4.8).
' Render:  plantuml -tsvg uc-contracts.puml && \
'          rsvg-convert -f pdf -o uc-contracts.pdf uc-contracts.svg
'==============================================================================
left to right direction
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam ranksep 60
skinparam nodesep 12
skinparam usecase {
  BorderColor      #34495E
  BackgroundColor  #FDFEFE
  ArrowColor       #5D6D7E
}

actor "Legal Manager" as lm
actor "User"          as user
lm --|> user

rectangle "Contracts & documents" {
  usecase "Register contract"     as UC_register
  usecase "Edit contract"         as UC_edit
  usecase "Archive contract"      as UC_archive
  usecase "Search / filter\ncontracts" as UC_search
  usecase "Attach document link"  as UC_attach
  usecase "Detach document link"  as UC_detach
  usecase "Capture fields with\nintelligence" as UC_intel
  usecase "Send for electronic\nsignature"    as UC_esign
}

lm --> UC_register
lm --> UC_edit
lm --> UC_archive
lm --> UC_search
lm --> UC_attach
lm --> UC_detach
lm --> UC_esign
UC_intel ..> UC_attach : <<extend>>

note bottom of UC_archive
  Archive only — no hard
  delete (immutability, GoBD)
end note
@enduml
