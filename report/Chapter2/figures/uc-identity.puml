@startuml uc-identity
'==============================================================================
' Detailed use cases: Identity & access (Sec. 4.7).
' Render:  plantuml -tsvg uc-identity.puml && \
'          rsvg-convert -f pdf -o uc-identity.pdf uc-identity.svg
'==============================================================================
left to right direction
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam ranksep 60
skinparam nodesep 12
skinparam usecase {
  BorderColor      #34495E
  BackgroundColor  #FDFEFE
  ArrowColor       #5D6D7E
}

actor "User"  as user
actor "Admin" as admin
admin --|> user

rectangle "Identity & access" {
  usecase "Authenticate"                  as UC_auth
  usecase "Verify second factor\n(email OTP)" as UC_mfa
  usecase "Reset password"                as UC_reset
  usecase "Accept invitation"             as UC_acceptinv
  usecase "Provision /\ndecommission user" as UC_users
  usecase "Invite user"                   as UC_invite
  usecase "Assign roles"                  as UC_roles
  usecase "Revoke access"                 as UC_revoke
  usecase "Configure organisation-\nwide policies" as UC_policy
  usecase "Define per-tenant\ncustom fields"  as UC_custom
}

user  --> UC_auth
user  --> UC_reset
user  --> UC_acceptinv
UC_auth ..> UC_mfa : <<include>>

admin --> UC_users
admin --> UC_invite
admin --> UC_roles
admin --> UC_revoke
admin --> UC_policy
admin --> UC_custom

note bottom of UC_mfa
  Mandatory for Admin;
  offered to every role
end note
@enduml
