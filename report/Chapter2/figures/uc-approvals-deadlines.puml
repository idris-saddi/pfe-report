@startuml uc-approvals-deadlines
'==============================================================================
' Detailed use cases: Approvals and Deadlines & obligations.
' Standard arrangement: actors LEFT, use cases in the boundary MIDDLE, the
' secondary System clock actor RIGHT. The workflow-template step is "Define"
' (was "Select"). No out-of-scope actor appears here, so no scope colouring
' (supervisor feedback).
' Render:  make figures
'==============================================================================
left to right direction
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam linetype polyline
skinparam ranksep 110
skinparam nodesep 20
skinparam usecase {
  BorderColor      #34495E
  BackgroundColor  #FDFEFE
  ArrowColor       #5D6D7E
}
skinparam actor {
  BorderColor      #34495E
}

actor "Legal Manager" as lm
actor "Approver"      as appr

rectangle "Approvals & deadlines" {
  usecase "Initiate approval\nworkflow" as UC_initappr
  usecase "Define workflow\ntemplate"  as UC_template
  usecase "Send deadline\nreminder"    as UC_remind
  usecase "Acknowledge\ndeadline reminder" as UC_ack
  usecase "Track post-signature\nobligations" as UC_oblig
  usecase "Consult approval\nhistory"  as UC_apprhist
  together {
    usecase "Decide on approval step\n(approve / reject /\nrequest changes)" as UC_decide
    usecase "Return contract\nto initiator" as UC_return
  }
}

lm    --> UC_initappr
lm    --> UC_remind
lm    --> UC_apprhist
lm    --> UC_ack
lm    --> UC_oblig
appr  --> UC_decide
appr  --> UC_apprhist
' Base use case on the left, the included / extending use case to its
' right; «include» points at the included case, «extend» points back at
' the base (UML standard).
UC_initappr ..> UC_template : <<include>>
UC_decide   <.. UC_return   : <<extend>>

' Secondary actor (far right; hidden edge pushes it past the inner column)
actor "System clock" as clock
UC_remind --> clock
UC_template -[hidden]-> clock

 note left of UC_remind
  Fires 90 / 60 / 30 days before
  the notice window, and on close
end note
@enduml
